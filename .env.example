# Copy to server/.env (or set these in your hosting provider's dashboard).
# NEVER commit real values.

# --- Required ---------------------------------------------------------------
# PostgreSQL connection for the application.
DATABASE_URL=postgres://charity_app:CHANGE_ME@localhost:5432/empty_bowls
# Long random string used to sign session cookies (min 32 chars in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# The public URL of the app (used in links in emails).
APP_BASE_URL=https://donations.example.org
NODE_ENV=production

# --- Recommended ------------------------------------------------------------
# Read-only role that can ONLY see the public_* views (see "Least-privilege database roles").
PUBLIC_DATABASE_URL=postgres://charity_public:CHANGE_ME@localhost:5432/empty_bowls
# Set to true if your database requires SSL (most managed hosts do).
DATABASE_SSL=false
# Separate secret for hashing IP addresses (defaults to SESSION_SECRET).
HASH_SALT=
# Local time zone used for "due today" and "overdue".
APP_TIMEZONE=America/Toronto

# --- Email (optional: without it, notifications are in-app only) ------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Empty Bowls <donations@example.org>"

# --- Other options ----------------------------------------------------------
PORT=3000
# Where uploaded images are stored. Must be on a persistent disk/volume.
UPLOAD_DIR=/var/data/uploads
MAX_UPLOAD_MB=5
SESSION_MAX_AGE_HOURS=8
# Public submissions allowed per IP address per hour.
PUBLIC_SUBMISSION_RATE_LIMIT=10
# Number of reverse proxies in front of the app (1 for Render/Railway/Heroku/Nginx).
TRUST_PROXY=1
# Set to false to run migrations manually instead of at start-up.
AUTO_MIGRATE=true
# Websites allowed to embed the public form / gallery in an iframe (comma separated).
EMBED_ALLOWED_ORIGINS=https://www.example.org
